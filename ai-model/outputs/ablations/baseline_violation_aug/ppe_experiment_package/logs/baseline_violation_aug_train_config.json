{
  "experiment": "baseline_violation_aug",
  "target": "imbalance_aug",
  "model": "yolo26n.pt",
  "data": "/kaggle/working/configs/data_baseline_violation_aug.yaml",
  "epochs": 50,
  "imgsz": 640,
  "batch": 64,
  "device": "0,1",
  "seed": 42,
  "hparams": {
    "optimizer": "AdamW",
    "lr0": 0.001,
    "lrf": 0.01,
    "warmup_epochs": 5,
    "cos_lr": true,
    "label_smoothing": 0.1,
    "mosaic": 1.0,
    "mixup": 0.25,
    "copy_paste": 0.25,
    "degrees": 10.0,
    "translate": 0.25,
    "scale": 0.65,
    "fliplr": 0.5
  },
  "fast_debug": false
}
